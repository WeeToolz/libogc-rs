{
  "llvm-target": "powerpc-nintendo-none",
  "arch": "powerpc",
  "vendor": "nintendo",
  "os": "none",
  "env": "eabi",
  "target-endian": "big",
  "target-pointer-width": 32,
  "data-layout": "E-m:e-p:32:32-Fn32-i64:64-n32",
  "cpu": "750",
  "max-atomic-width": 32,
  "panic-strategy": "abort",
  "relocation-model": "static",
  "executables": true,
  "dynamic-linking": false,
  "disable-redzone": true
}
